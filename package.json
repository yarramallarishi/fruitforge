{
  "name": "fruitforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "deploy": "npm run db:remote && npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply fruitforge-db --local",
    "db:remote": "wrangler d1 migrations apply fruitforge-db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
